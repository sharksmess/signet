{
  "name": "signet",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @signet/web dev",
    "build": "pnpm --filter @signet/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @signet/web run typecheck && pnpm --filter @signet/db run typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "pnpm typecheck && pnpm lint",
    "db:generate": "pnpm --filter @signet/db run generate",
    "db:migrate": "pnpm --filter @signet/db run migrate"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "zod": "4.6.5"
  }
}
