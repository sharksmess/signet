# Environnement de l'etape Build de la CI (usine 1.6), lu par scripts/ci-build.sh,
# en CI comme en local. UNIQUEMENT des valeurs INVENTEES : jamais de vraie cle.
# N'y mettre que ce que `next build` exige reellement ; un module qui lit un
# secret au chargement doit plutot le lire au premier usage (Signet D-079).
# next build charge apps/web/src/lib/auth.ts, qui lit ces variables au
# chargement ; les pools pg ne se connectent qu'a la premiere requete.
DATABASE_URL_APP=postgresql://signet_app@localhost:5432/signet_test
DATABASE_URL_AUTH=postgresql://signet_auth@localhost:5432/signet_test
BETTER_AUTH_SECRET=ci-only-better-auth-secret-not-a-real-secret-0001
