# Copier en .env.test.local (ignore par git). Rempli par l'HUMAIN : les agents
# ne lisent ni n'ecrivent ce fichier. Les tests le chargent eux-memes.

# Connexion d'administration (superutilisateur) a la base de maintenance.
TEST_DATABASE_ADMIN_URL=postgresql://postgres:MOT_DE_PASSE@localhost:5432/postgres
# Base dediee aux tests, detruite et recreee a chaque lancement. Doit finir par _test.
TEST_DATABASE_NAME=monprojet_test

# Schemas applicatifs soumis aux invariants du catalogue (RLS forcee, SECURITY DEFINER).
TEST_APP_SCHEMAS=public
# Tables volontairement sans RLS, schema.table separes par des virgules, chacune justifiee par un ADR.
TEST_RLS_EXEMPT_TABLES=

# Serveur applicatif demarre par les tests (retirer TEST_APP_BASE_URL si aucun test HTTP).
TEST_APP_BASE_URL=http://localhost:3100
# Variables transmises au serveur de test sans le prefixe TEST_SERVER_ENV_.
# Elles pointent sur la base de TEST, jamais sur celle de dev.
TEST_SERVER_ENV_DATABASE_URL=postgresql://app_role:MOT_DE_PASSE@localhost:5432/monprojet_test
TEST_SERVER_ENV_BETTER_AUTH_SECRET=secret-de-test-local-au-moins-32-caracteres
TEST_SERVER_ENV_BETTER_AUTH_URL=http://localhost:3100
# Limiteur de debit better-auth coupe pour la suite (ADR-0010). off n'est accepte
# qu'avec APP_ENV=test : toute autre combinaison empeche le serveur de demarrer.
TEST_SERVER_ENV_AUTH_RATE_LIMIT=off
TEST_SERVER_ENV_APP_ENV=test

# Role signet_billing (tranche 002, migration 0011). Mot de passe fixe par
# l'humain : docs/04-runbooks/stripe-facturation-locale.md. Les deux URL
# designent la base de TEST (TEST_DATABASE_NAME) et sont identiques.
# Connexion de la suite de tests sous signet_billing :
TEST_DATABASE_URL_BILLING=postgresql://signet_billing:MOT_DE_PASSE@localhost:5432/monprojet_test
# Transmise au serveur de test sous le nom DATABASE_URL_BILLING :
TEST_SERVER_ENV_DATABASE_URL_BILLING=postgresql://signet_billing:MOT_DE_PASSE@localhost:5432/monprojet_test

# Options : TEST_SKIP_BUILD=1 pour reutiliser le dernier build pendant une iteration.

# Facturation (tranche 002, D-059) : valeurs INVENTEES, jamais de vraie cle.
# Le serveur de test parle au faux Stripe et au faux point d'evenements
# Inngest, demarres par les tests sur ces deux ports locaux.
TEST_FAKE_STRIPE_PORT=12111
TEST_FAKE_INNGEST_PORT=12112
# Secret de signature des webhooks : meme valeur pour la suite et le serveur.
TEST_STRIPE_WEBHOOK_SECRET=whsec_test_local_invente_0001
TEST_SERVER_ENV_STRIPE_WEBHOOK_SECRET=whsec_test_local_invente_0001
TEST_SERVER_ENV_STRIPE_SECRET_KEY=sk_test_local_invente_0001
TEST_SERVER_ENV_STRIPE_PRICE_ID_PRO=price_test_local_pro_0001
# Acceptee seulement avec APP_ENV=test : doit viser TEST_FAKE_STRIPE_PORT.
TEST_SERVER_ENV_STRIPE_API_BASE_URL=http://localhost:12111
# Mode developpement d'Inngest (APP_ENV=test ou development seulement) : doit
# viser TEST_FAKE_INNGEST_PORT.
TEST_SERVER_ENV_INNGEST_DEV=http://localhost:12112
TEST_SERVER_ENV_APP_URL=http://localhost:3100
