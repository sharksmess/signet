# Modele du fichier d'environnement de DEVELOPPEMENT (.env, ignore par git).
# Rempli par l'HUMAIN : les agents ne lisent ni n'ecrivent le vrai fichier.
# Noms seulement : chaque valeur ci-dessous est factice (MOT_DE_PASSE, etc.).
# Chaque variable est validee par un schema au demarrage du serveur.

# Connexion de migration (superutilisateur de l'instance locale), lue par
# pnpm db:migrate seulement (packages/db/src/migrate.ts, ADR-0007).
DATABASE_URL_MIGRATE=postgresql://postgres:MOT_DE_PASSE@localhost:5432/signet

# Roles applicatifs (ADR-0007). Mots de passe fixes par l'humain, jamais dans
# une migration.
DATABASE_URL_APP=postgresql://signet_app:MOT_DE_PASSE@localhost:5432/signet
DATABASE_URL_AUTH=postgresql://signet_auth:MOT_DE_PASSE@localhost:5432/signet
# Role signet_billing (tranche 002, migration 0011) : lu par la seule fonction
# Inngest de traitement des evenements Stripe (AC16). Procedure du mot de
# passe : docs/04-runbooks/stripe-facturation-locale.md.
DATABASE_URL_BILLING=postgresql://signet_billing:MOT_DE_PASSE@localhost:5432/signet

# better-auth (ADR-0004).
BETTER_AUTH_SECRET=au-moins-32-caracteres-aleatoires-a-generer
BETTER_AUTH_URL=http://localhost:3100

APP_ENV=development

# Facturation (tranche 002). Parcours Stripe reel en mode TEST seulement,
# facultatif : docs/04-runbooks/stripe-facturation-locale.md.
# URL de base des liens de retour du Checkout.
APP_URL=http://localhost:3100
# Cle secrete du compte Stripe en mode test (sk_test_...).
STRIPE_SECRET_KEY=sk_test_A_REMPLACER
# Secret donne par `stripe listen` ou par le point de terminaison (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_A_REMPLACER
# Identifiant du prix Pro cree dans Stripe (price_...).
STRIPE_PRICE_ID_PRO=price_A_REMPLACER
# STRIPE_API_BASE_URL : reserve aux tests (APP_ENV=test), a laisser absente.

# Inngest (ADR-0006). En local : INNGEST_DEV=1 (serveur de developpement
# Inngest, facultatif) ; INNGEST_EVENT_KEY et INNGEST_SIGNING_KEY absentes.
# Hors mode developpement (production) : les deux cles sont exigees au
# demarrage, et INNGEST_DEV y est refusee.
INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
